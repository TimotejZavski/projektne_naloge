@page "/sensors"
@inject ISensorService SensorService
@inject ISensorDataRepository SensorDataRepository
@implements IAsyncDisposable

<PageTitle>Meritve v živo</PageTitle>

<div class="sensor-dashboard">
    <section class="sensor-hero">
        <div class="sensor-hero__copy">
            <p class="sensor-kicker">Smart Playgrounds</p>
            <h1>Meritve v živo</h1>
            <p class="sensor-lead">Trenutni zajem GPS lokacije in pospeškometra med obiskom igrišča.</p>
            <div class="sensor-actions">
                <button class="btn btn-primary sensor-primary-action" @onclick="RefreshAsync" disabled="@isLoading">
                    @(isLoading ? "Osvežujem…" : "Osveži")
                </button>
                <button class="btn btn-outline-secondary sensor-secondary-action" @onclick="ClearHistoryAsync" disabled="@isLoading || !sensorHistory.Any()">
                    Počisti zgodovino
                </button>
            </div>
        </div>

        <div class="sensor-hero__status">
            <div class="sensor-status-card">
                <span class="sensor-status-dot @GetConnectionDotClass()"></span>
                <div>
                    <div class="sensor-status-label">Zajem</div>
                    <div class="sensor-status-value">@GetConnectionStatus()</div>
                </div>
            </div>
            <div class="sensor-status-card sensor-status-card--accent">
                <div>
                    <div class="sensor-status-label">Shranjeni vzorci</div>
                    <div class="sensor-status-value">@sensorHistory.Count</div>
                </div>
            </div>
        </div>
    </section>

    @if (isLoading && !sensorHistory.Any())
    {
        <div class="sensor-loading">
            <em>Nalagam meritve…</em>
        </div>
    }
    else
    {
        <div class="row g-3 mb-4 sensor-metric-grid">
            <div class="col-12 col-lg-6">
                <div class="card shadow-sm h-100 sensor-panel">
                    <div class="card-body">
                        <div class="sensor-panel__header">
                            <h2 class="h5 card-title mb-0">Lokacija</h2>
                            <span class="sensor-pill sensor-pill--gps">GPS</span>
                        </div>
                        @if (latestGpsData is null)
                        {
                            <p class="text-muted mb-0">Lokacija se bo prikazala ob prvem zajemu na igrišču.</p>
                        }
                        else
                        {
                            <div class="sensor-metrics">
                                <div class="sensor-metric">
                                    <span class="sensor-metric__label">Zem. širina</span>
                                    <span class="sensor-metric__value">@latestGpsData.Latitude</span>
                                </div>
                                <div class="sensor-metric">
                                    <span class="sensor-metric__label">Zem. dolžina</span>
                                    <span class="sensor-metric__value">@latestGpsData.Longitude</span>
                                </div>
                                <div class="sensor-metric sensor-metric--wide">
                                    <span class="sensor-metric__label">Čas</span>
                                    <span class="sensor-metric__value">@latestGpsData.Timestamp.ToLocalTime()</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-6">
                <div class="card shadow-sm h-100 sensor-panel">
                    <div class="card-body">
                        <div class="sensor-panel__header">
                            <h2 class="h5 card-title mb-0">Gibanje</h2>
                            <span class="sensor-pill sensor-pill--accel">Pospeškometer</span>
                        </div>
                        @if (latestAccelerometerData is null)
                        {
                            <p class="text-muted mb-0">Meritve gibanja se bodo prikazale ob aktivnem zajemu.</p>
                        }
                        else
                        {
                            <div class="sensor-metrics sensor-metrics--three">
                                <div class="sensor-metric">
                                    <span class="sensor-metric__label">X</span>
                                    <span class="sensor-metric__value">@latestAccelerometerData.X</span>
                                </div>
                                <div class="sensor-metric">
                                    <span class="sensor-metric__label">Y</span>
                                    <span class="sensor-metric__value">@latestAccelerometerData.Y</span>
                                </div>
                                <div class="sensor-metric">
                                    <span class="sensor-metric__label">Z</span>
                                    <span class="sensor-metric__value">@latestAccelerometerData.Z</span>
                                </div>
                                <div class="sensor-metric sensor-metric--wide">
                                    <span class="sensor-metric__label">Čas</span>
                                    <span class="sensor-metric__value">@latestAccelerometerData.Timestamp.ToLocalTime()</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm sensor-panel">
            <div class="card-body">
                <div class="sensor-panel__header sensor-panel__header--stacked mb-3">
                    <div>
                        <h2 class="h5 card-title mb-1">Zadnji vzorci</h2>
                        <p class="text-muted mb-0">Lokalna zgodovina zajetih meritev na tej napravi.</p>
                    </div>
                    <span class="sensor-pill sensor-pill--neutral">@sensorHistory.Count vnosov</span>
                </div>

                @if (!sensorHistory.Any())
                {
                    <p class="text-muted mb-0">Še ni meritev. Zajem poteka med obiskom igrišča.</p>
                }
                else
                {
                    <div class="table-responsive sensor-table-wrap">
                        <table class="table align-middle mb-0 sensor-table">
                            <thead>
                                <tr>
                                    <th>Tip</th>
                                    <th>Čas</th>
                                    <th>Podrobnosti</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in sensorHistory)
                                {
                                    <tr>
                                        <td>
                                            <span class="sensor-pill @GetSensorBadgeClass(item)">
                                                @GetSensorLabel(item)
                                            </span>
                                        </td>
                                        <td>@item.Timestamp.ToLocalTime()</td>
                                        <td>@GetSensorDetails(item)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading;
    private GPSData? latestGpsData;
    private AccelerometerData? latestAccelerometerData;
    private IReadOnlyList<SensorData> sensorHistory = Array.Empty<SensorData>();

    protected override async Task OnInitializedAsync()
    {
        SensorService.SensorDataUpdated += HandleSensorDataUpdated;
        await SensorService.InitializeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        SensorService.SensorDataUpdated -= HandleSensorDataUpdated;
        await SensorService.StopAsync();
    }

    private async Task RefreshAsync()
    {
        isLoading = true;
        StateHasChanged();

        await SensorService.InitializeAsync();

        isLoading = false;
    }

    private async Task ClearHistoryAsync()
    {
        await SensorDataRepository.ClearAsync();
        sensorHistory = Array.Empty<SensorData>();
        latestGpsData = null;
        latestAccelerometerData = null;
    }

    private void HandleSensorDataUpdated(object? sender, SensorDataUpdatedEventArgs eventArgs)
    {
        latestGpsData = eventArgs.GpsData;
        latestAccelerometerData = eventArgs.AccelerometerData;
        sensorHistory = eventArgs.Snapshot;

        _ = InvokeAsync(StateHasChanged);
    }

    private string GetConnectionStatus()
    {
        var gpsActive = SensorService.GPSSensor.IsActive;
        var accelActive = SensorService.AccelerometerSensor.IsActive;

        if (gpsActive && accelActive)
            return "Senzorji aktivni";

        if (gpsActive || accelActive)
            return "Delni zajem";

        return "Pripravljanje…";
    }

    private string GetConnectionDotClass()
    {
        if (SensorService.GPSSensor.IsActive && SensorService.AccelerometerSensor.IsActive)
            return "sensor-status-dot--active";

        if (SensorService.GPSSensor.IsActive || SensorService.AccelerometerSensor.IsActive)
            return "sensor-status-dot--partial";

        return "";
    }

    private static string GetSensorBadgeClass(SensorData sensorData) => sensorData switch
    {
        GPSData => "sensor-pill--gps",
        AccelerometerData => "sensor-pill--accel",
        _ => "sensor-pill--neutral"
    };

    private static string GetSensorLabel(SensorData sensorData) => sensorData switch
    {
        GPSData => "GPS",
        AccelerometerData => "Pospešek",
        _ => sensorData.Kind.ToString()
    };

    private static string GetSensorDetails(SensorData sensorData) => sensorData switch
    {
        GPSData gpsData => $"Lat: {gpsData.Latitude}, Lon: {gpsData.Longitude}",
        AccelerometerData accelerometerData => $"X: {accelerometerData.X}, Y: {accelerometerData.Y}, Z: {accelerometerData.Z}",
        _ => "Neznana meritev"
    };
}
