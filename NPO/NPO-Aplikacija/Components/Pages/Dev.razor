@page "/dev"
@inject NPO_Aplikacija.Services.ISensorDataRepository SensorDataRepository
@inject NPO_Aplikacija.Services.ISensorService SensorService

<PageTitle>Razvojna orodja</PageTitle>

<div class="dev-page">
    <h1>Razvojna orodja</h1>
    <p>Orodja za testiranje. Počisti lokalno shranjene meritve na napravi.</p>

    <div class="dev-actions">
        <button class="btn btn-danger" @onclick="HandleDeleteAsync" disabled="@isProcessing">@buttonText</button>
        @if (!string.IsNullOrEmpty(message))
        {
            <div class="mt-2 dev-message">@message</div>
        }
    </div>
</div>

@code {
    private bool isProcessing = false;
    private bool confirm = false;
    private string buttonText = "Počisti vse meritve";
    private string? message;

    private async Task HandleDeleteAsync()
    {
        if (!confirm)
        {
            confirm = true;
            buttonText = "Potrdite ponovni klik";
            _ = Task.Run(async () =>
            {
                await Task.Delay(5000);
                confirm = false;
                buttonText = "Počisti vse meritve";
                await InvokeAsync(StateHasChanged);
            });
            return;
        }

        // proceed with delete
        isProcessing = true;
        message = null;
        try
        {
            await SensorDataRepository.ClearAsync();
            message = "Vse lokalne meritve so počiščene.";

            // reinitialize sensors so UI gets fresh state
            await SensorService.InitializeAsync();
        }
        catch (Exception ex)
        {
            message = $"Napaka pri brisanju: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
            confirm = false;
            buttonText = "Počisti vse meritve";
        }
    }
}
