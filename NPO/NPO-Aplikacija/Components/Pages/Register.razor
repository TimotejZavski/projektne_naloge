@page "/register"
@layout AuthLayout
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Registracija</PageTitle>

<EditForm Model="@registrationModel" OnValidSubmit="@HandleValidSubmitAsync" class="auth-form">
    <DataAnnotationsValidator />

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="auth-alert" role="alert">@errorMessage</div>
    }

    <div class="auth-field">
        <label for="displayName">Ime</label>
        <input id="displayName"
               type="text"
               autocomplete="name"
               value="@registrationModel.DisplayName"
               @oninput="@(e => registrationModel.DisplayName = e.Value?.ToString() ?? string.Empty)" />
        <ValidationMessage For="@(() => registrationModel.DisplayName)" />
    </div>

    <div class="auth-field">
        <label for="email">E-poštni naslov</label>
        <input id="email"
               type="email"
               autocomplete="email"
               value="@registrationModel.Email"
               @oninput="@(e => registrationModel.Email = e.Value?.ToString() ?? string.Empty)" />
        <ValidationMessage For="@(() => registrationModel.Email)" />
    </div>

    <div class="auth-field">
        <label for="password">Geslo</label>
        <input id="password"
               type="password"
               autocomplete="new-password"
               value="@registrationModel.Password"
               @oninput="@(e => registrationModel.Password = e.Value?.ToString() ?? string.Empty)" />
        <ValidationMessage For="@(() => registrationModel.Password)" />
    </div>

    <div class="auth-field">
        <label for="confirmPassword">Potrditev gesla</label>
        <input id="confirmPassword"
               type="password"
               autocomplete="new-password"
               value="@registrationModel.ConfirmPassword"
               @oninput="@(e => registrationModel.ConfirmPassword = e.Value?.ToString() ?? string.Empty)" />
        <ValidationMessage For="@(() => registrationModel.ConfirmPassword)" />
    </div>

    <div class="auth-terms">
        <InputCheckbox id="acceptTerms" @bind-Value="registrationModel.AcceptTerms" />
        <label for="acceptTerms">Sprejemam pogoje uporabe aplikacije.</label>
    </div>
    <ValidationMessage For="@(() => registrationModel.AcceptTerms)" />

    <button type="submit" class="btn btn-primary auth-submit" disabled="@isSubmitting">
        @(isSubmitting ? "Shranjevanje..." : "Ustvari račun")
    </button>
</EditForm>

@code {
    private RegistrationFormModel registrationModel = new();
    private bool isSubmitting;
    private string? errorMessage;

    private async Task HandleValidSubmitAsync()
    {
        isSubmitting = true;
        errorMessage = null;

        var result = await AuthService.RegisterAsync(registrationModel);

        if (result.Success)
        {
            Navigation.NavigateTo("/", replace: true);
            return;
        }

        errorMessage = result.Message;
        isSubmitting = false;
    }
}
