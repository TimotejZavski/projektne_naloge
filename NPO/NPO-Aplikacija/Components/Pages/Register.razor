@page "/register"
@inject IUserRegistrationService UserRegistrationService

<PageTitle>Registracija</PageTitle>

<div class="register-page">
    <section class="register-panel">
        <div class="register-copy">
            <p class="register-kicker">Uporabniski racun</p>
            <h1>Registracija</h1>
            <p>
                Ustvarite racun za uporabo mobilne aplikacije in povezavo senzorskih podatkov z uporabnikom.
            </p>
        </div>

        <EditForm Model="@registrationModel" OnValidSubmit="@HandleValidSubmitAsync" class="register-form">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrWhiteSpace(successMessage))
            {
                <div class="alert alert-success" role="status">@successMessage</div>
            }

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger" role="alert">@errorMessage</div>
            }

            <ValidationSummary />

            <div class="mb-3">
                <label for="displayName" class="form-label">Ime</label>
                <InputText id="displayName" class="form-control" @bind-Value="registrationModel.DisplayName" />
                <ValidationMessage For="@(() => registrationModel.DisplayName)" />
            </div>

            <div class="mb-3">
                <label for="email" class="form-label">E-postni naslov</label>
                <InputText id="email" type="email" class="form-control" @bind-Value="registrationModel.Email" />
                <ValidationMessage For="@(() => registrationModel.Email)" />
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">Geslo</label>
                <InputText id="password" type="password" class="form-control" @bind-Value="registrationModel.Password" />
                <ValidationMessage For="@(() => registrationModel.Password)" />
            </div>

            <div class="mb-3">
                <label for="confirmPassword" class="form-label">Potrditev gesla</label>
                <InputText id="confirmPassword" type="password" class="form-control" @bind-Value="registrationModel.ConfirmPassword" />
                <ValidationMessage For="@(() => registrationModel.ConfirmPassword)" />
            </div>

            <div class="form-check register-terms">
                <InputCheckbox id="acceptTerms" class="form-check-input" @bind-Value="registrationModel.AcceptTerms" />
                <label for="acceptTerms" class="form-check-label">
                    Sprejemam pogoje uporabe aplikacije.
                </label>
                <ValidationMessage For="@(() => registrationModel.AcceptTerms)" />
            </div>

            <button type="submit" class="btn btn-primary register-submit" disabled="@isSubmitting">
                @(isSubmitting ? "Shranjevanje..." : "Registriraj uporabnika")
            </button>
        </EditForm>
    </section>
</div>

@code {
    private RegistrationFormModel registrationModel = new();
    private bool isSubmitting;
    private string? successMessage;
    private string? errorMessage;

    private async Task HandleValidSubmitAsync()
    {
        isSubmitting = true;
        successMessage = null;
        errorMessage = null;

        var result = await UserRegistrationService.RegisterAsync(registrationModel);

        if (result.Success)
        {
            successMessage = result.Message;
            registrationModel = new RegistrationFormModel();
        }
        else
        {
            errorMessage = result.Message;
        }

        isSubmitting = false;
    }
}
