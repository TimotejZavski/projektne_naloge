@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main class="app-main">
        <header class="app-header">
            <div>
                <span class="app-eyebrow">Smart Playgrounds</span>
                <h1>Mobilni zajem</h1>
            </div>
            <div class="app-header__meta" aria-label="Stanje sistema">
                <span>GPS + pospeškometer</span>
                <span>Pošiljanje na nadzorno ploščo</span>
            </div>
        </header>

        <article class="content app-content">
            @Body
        </article>
    </main>
</div>
