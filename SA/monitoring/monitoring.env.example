# SCRUM-43: konfiguracija monitoringa (kopiraj v monitoring.env)

# Backend health endpoint
BACKEND_PORT=5000
HEALTH_URL=http://localhost:5000/health

# Docker container imena (SA/setup.sh ali RAI/server docker-compose)
CONTAINER_BACKEND=rai-backend
CONTAINER_MONGO=rai-mongo
CONTAINER_MQTT=smart-playgrounds-mqtt

# Compose mapa za backup-mongo.sh (po vrsti: SA, RAI/server)
# MONITOR_COMPOSE_DIR=/path/to/SA

# Log datoteka (cron mora imeti write dostop)
LOG_FILE=/var/log/rai-monitor.log

# Disk: opozori ce je zasedenost root partition >= tega %
DISK_THRESHOLD=85

# Backup MongoDB
BACKUP_DIR=/var/backups/rai-mongo
BACKUP_RETENTION_DAYS=7

# Opcijsko: Discord webhook ob napaki (pusti prazno ce ne uporabljas)
DISCORD_WEBHOOK_URL=
