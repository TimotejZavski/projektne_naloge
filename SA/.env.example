# ============================================================
# Smart Playgrounds - okoljske spremenljivke (SCRUM-38)
# ============================================================
# Kopiraj v `.env` (setup.sh to naredi avtomatsko):
#   cp .env.example .env
#
# `.env` NIKOLI ne sme priti v git.
# ============================================================

# --- Streznik ---
NODE_ENV=production
BACKEND_PORT=5000

# --- MongoDB ---
# `mongo` je service name v docker-compose.yml (NE localhost).
MONGO_PORT=27017
MONGO_DATABASE=rai
MONGODB_URI=mongodb://mongo:27017/rai

# --- MQTT ---
# `mosquitto` je service name v docker-compose.yml.
MQTT_PORT=1883
MQTT_WS_PORT=9001
MQTT_BROKER_URL=mqtt://mosquitto:1883
MQTT_ENABLED=true

# --- JWT ---
# setup.sh generira vrednosti ce ostanejo placeholderji.
# Rocno: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE-ME-generate-with-crypto-randomBytes-64-hex
JWT_REFRESH_SECRET=CHANGE-ME-DIFFERENT-from-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Bcrypt ---
BCRYPT_SALT_ROUNDS=12

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Rate limiting ---
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_REGISTER_WINDOW_MS=3600000
RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_GENERAL_WINDOW_MS=900000

# --- Cookie (refresh token) ---
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
