# ============================================================
# Smart Playgrounds RAI backend - okoljske spremenljivke
# ============================================================
# Kopiraj v `.env` in nastavi vrednosti za svoje okolje.
# `.env` NIKOLI ne sme priti v git (glej .gitignore).
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=5000

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/rai

# --- JWT ---
# Generiraj nakljucni tajni kljuc:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Skrivnosti za access in refresh ZGOLJ NIKOLI ne smeta biti enaki.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-min-64-chars
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string-min-64-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Bcrypt ---
# 12 = priporocena vrednost za 2026 (cca 250 ms na hash)
BCRYPT_SALT_ROUNDS=12

# --- CORS ---
# Locite z vejico, brez presledkov.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Rate limiting ---
# Strožji limit za login (preprecuje brute force).
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_GENERAL_WINDOW_MS=900000

# --- Cookie (refresh token) ---
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
