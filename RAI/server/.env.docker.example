# ============================================================
# Docker Compose - okoljske spremenljivke za RAI backend
# ============================================================
# Kopiraj v `.env.docker` in nastavi vrednosti.
# `.env.docker` NIKOLI ne sme priti v git (.gitignore ze pokriva .env*).
#
# OPOMBA: To je OBLOZNA datoteka za docker-compose.yml.
# Lokalni razvoj BREZ docker-ja uporablja `.env` (glej .env.example).
# ============================================================

# --- Server ---
NODE_ENV=production
# Port na host strani (znotraj container-ja je vedno 5000).
BACKEND_PORT=5000

# --- MongoDB ---
# `mongo` je service name iz docker-compose.yml -> Docker resolva
# avtomatsko v IP container-ja. NE uporabljaj 'localhost' tukaj
# (znotraj container-ja bi pomenilo container sam).
MONGODB_URI=mongodb://mongo:27017/rai
MONGO_DATABASE=rai

# --- MQTT broker (SCRUM-37) ---
# `mosquitto` je service name iz docker-compose.yml. Isto pravilo kot
# pri MONGODB_URI - ne uporabljaj localhost znotraj container-ja.
# Compose override-a to vrednost na 'mqtt://mosquitto:1883', tukaj jo
# pustimo zaradi dokumentacije.
MQTT_BROKER_URL=mqtt://mosquitto:1883
# Postavi MQTT_ENABLED=false v okoljih, kjer broker ni dosegljiv (npr.
# Render brez MQTT containerja) - backend bo presel HTTP-only mode.
MQTT_ENABLED=true
# Vrata, ki jih compose mapira na host (samo za razvoj; v produkciji
# odstrani 'ports:' v docker-compose.yml za broker).
MQTT_PORT=1883
MQTT_WS_PORT=9001

# --- JWT ---
# !!! OBVEZNO ZAMENJAJ Z DEJANSKIMI VREDNOSTMI !!!
# Generiraj:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE-ME-generate-with-crypto-randomBytes-64-hex
JWT_REFRESH_SECRET=CHANGE-ME-DIFFERENT-from-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Bcrypt ---
BCRYPT_SALT_ROUNDS=12

# --- CORS ---
# Locite z vejico, brez presledkov.
# Za frontend v Docker compose: dodaj internal Docker URL.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Rate limiting ---
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_REGISTER_WINDOW_MS=3600000
RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_GENERAL_WINDOW_MS=900000

# --- Cookie (refresh token) ---
# COOKIE_SECURE=true ZAHTEVA HTTPS - postavi true SAMO v produkciji za
# reverse proxy s TLS. V devu pusti false (cookies preko http).
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
