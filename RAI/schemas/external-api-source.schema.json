{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-playgrounds.local/schemas/external-api-source.schema.json",
  "title": "ExternalApiSource",
  "type": "object",
  "required": [
    "sourceName",
    "sourceType",
    "fetchedAtUtc",
    "data"
  ],
  "properties": {
    "sourceName": {
      "type": "string",
      "minLength": 1
    },
    "sourceType": {
      "type": "string",
      "enum": [
        "weather",
        "playground",
        "traffic",
        "environment"
      ]
    },
    "sourceUrl": {
      "type": "string",
      "format": "uri"
    },
    "fetchedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "location": {
      "type": "object",
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "additionalProperties": false
    },
    "data": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
