{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-playgrounds.local/schemas/sensor-measurement.schema.json",
  "title": "SensorMeasurement",
  "type": "object",
  "required": [
    "schemaVersion",
    "deviceId",
    "sensorType",
    "timestampUtc",
    "data"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "deviceId": {
      "type": "string",
      "minLength": 1
    },
    "userId": {
      "type": [
        "string",
        "null"
      ]
    },
    "sensorType": {
      "type": "string",
      "enum": [
        "gps",
        "accelerometer",
        "camera"
      ]
    },
    "timestampUtc": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "latitude",
            "longitude"
          ],
          "properties": {
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "accuracyMeters": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            },
            "unit": {
              "type": "string",
              "default": "m/s2"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "captureId",
            "mediaType",
            "gps"
          ],
          "properties": {
            "captureId": {
              "type": "string",
              "minLength": 1
            },
            "mediaType": {
              "type": "string",
              "enum": [
                "image/jpeg",
                "image/png",
                "image/webp"
              ]
            },
            "imageUrl": {
              "type": "string",
              "format": "uri"
            },
            "gps": {
              "type": "object",
              "required": [
                "latitude",
                "longitude"
              ],
              "properties": {
                "latitude": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "longitude": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                "accuracyMeters": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
