# ORV FastAPI service
ORV_PORT=8000
ORV_PUBLIC_URL=http://localhost:8000
ORV_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Paths inside the Docker container.
ORV_STREAM_DIR=/app/dataset/valid/videos
ORV_MEDIA_DIR=/app/service/media
ORV_PYTHON=/usr/local/bin/python

# Processing/rendering defaults.
ORV_PROC_WIDTH=960
ORV_JPEG_QUALITY=80
